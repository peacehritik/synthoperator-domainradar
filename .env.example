# ==============================================================================
# SynthOperator Domain Decision Intelligence Platform
# Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=3000

# Application Branding & Domain Settings
APP_NAME="SynthOperator DomainRadar"
APP_URL="https://synthoperator.com"

# Upstream Decision Engine (Optional)
# If left blank, the platform automatically operates in 100% free local
# deterministic simulation mode without any external API costs.
TYPESAFE_API_KEY=

# Batch Audit Controlled Concurrency Limit (Default: 4)
BULK_AUDIT_CONCURRENCY=4